# Autonomous Giving — preferred environment contract (SPEC-025)
# Copy to product repo `.env` / `.env.example`. NEVER commit real secrets.
# Preferred hosted stack: Cloudflare + Supabase (ADR-013). Clerk/Stripe/Resend/OpenAI only if still required.

# --- DATABASE (Supabase PostgreSQL / local) ---
DATABASE_URL=postgresql://user:password@localhost:5432/agi

# --- AUTH (Supabase — preferred) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only

# --- AUTH (Clerk — only if a product still requires it) ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# CLERK_SECRET_KEY=sk_test_replace_me
# CLERK_WEBHOOK_SECRET=whsec_replace_me

# --- STRIPE (if the product still requires Stripe) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- RESEND (if the product still requires email) ---
RESEND_API_KEY=re_replace_me
EMAIL_FROM=noreply@example.com

# --- OPENAI / AI (if the product still requires AI) ---
OPENAI_API_KEY=sk-replace_me
# AI_PROVIDER=openai

# --- APPLICATION ---
APP_URL=http://localhost:3000
NODE_ENV=development
