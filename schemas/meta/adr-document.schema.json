{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomousgiving.org/schemas/meta/adr-document/1.0.0",
  "title": "ADR document frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "version", "status", "authority", "owner"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ADR-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "proposed", "accepted", "deprecated", "superseded"]
    },
    "authority": {
      "type": "string",
      "enum": ["normative", "informative"]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "related_specs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^SPEC-[0-9]{3}[A-Z]?$" },
      "uniqueItems": true
    }
  }
}
