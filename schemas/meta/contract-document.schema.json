{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomousgiving.org/schemas/meta/contract-document/1.0.0",
  "title": "CONTRACT document frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "version", "status", "authority", "owner", "schema"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CONTRACT-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "proposed", "accepted", "deprecated", "superseded"]
    },
    "authority": {
      "type": "string",
      "enum": ["normative", "informative"]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_stage": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string"
    },
    "consumer": {
      "type": "string"
    },
    "related_specs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^SPEC-[0-9]{3}[A-Z]?$" },
      "uniqueItems": true
    },
    "related_events": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EVENT-[0-9]{3}$" },
      "uniqueItems": true
    }
  }
}
