{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomousgiving.org/schemas/opportunity/1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["opportunityId", "needId", "title", "status", "createdAt"],
  "properties": {
    "opportunityId": { "type": "string", "format": "uuid" },
    "needId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["open", "dismissed", "converted"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "signalIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
