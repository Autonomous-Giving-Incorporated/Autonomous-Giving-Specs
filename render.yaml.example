# Illustrative Render Blueprint for AGI preferred MVP (SPEC-020 Profile B, SPEC-025).
# Copy to product repository as `render.yaml` and adjust names, repo, and commands.
# MVP: one web service + one PostgreSQL. No worker/cron/KV unless justified.

databases:
  - name: agi-postgres
    plan: basic-256mb
    databaseName: agi
    user: agi

services:
  - type: web
    name: agi-web
    runtime: node
    plan: starter
    # region: oregon
    # repo: https://github.com/ORG/PRODUCT  # set in dashboard or Blueprint as applicable
    branch: main
    autoDeploy: true
    buildCommand: npm ci && npm run build
    startCommand: npm run start
    healthCheckPath: /api/health
    envVars:
      - key: NODE_ENV
        value: production
      - key: APP_URL
        sync: false
      - key: DATABASE_URL
        fromDatabase:
          name: agi-postgres
          property: connectionString
      - key: NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
        sync: false
      - key: CLERK_SECRET_KEY
        sync: false
      - key: CLERK_WEBHOOK_SECRET
        sync: false
      - key: STRIPE_SECRET_KEY
        sync: false
      - key: STRIPE_WEBHOOK_SECRET
        sync: false
      - key: NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
        sync: false
      - key: RESEND_API_KEY
        sync: false
      - key: EMAIL_FROM
        sync: false
      - key: OPENAI_API_KEY
        sync: false

